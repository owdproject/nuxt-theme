{
  "name": "@owdproject/nuxt-theme-ui",
  "version": "4.0.0-alpha.5",
  "description": "Nuxt UI theme for Open Web Desktop",
  "keywords": [
    "owd-client",
    "owd-themes",
    "owd-modules"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "nx": {
    "name": "theme-nuxt"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare",
    "dev:prepare": "nuxt-module-build build --stub"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.4",
    "@owdproject/nuxt-kit-nuxt-ui": "^4.0.0-alpha.3",
    "defu": "^6.1.4",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.4",
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/nuxt-module-fs": "^4.0.0-alpha.3",
    "nuxt": "^4.4.4",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.2.7"
  },
  "peerDependencies": {
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/nuxt-kit-nuxt-ui": "^4.0.0-alpha.3",
    "@owdproject/nuxt-module-fs": "^4.0.0-alpha.3",
    "nuxt": "^4.4.4",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "peerDependenciesMeta": {
    "@owdproject/nuxt-module-fs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
